{
  "name": "rinka",
  "productName": "Rinka",
  "version": "0.1.0",
  "private": true,
  "description": "Rinka editor and library",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/zaroc-dev/rinka",
  "main": "dist/main.cjs",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "start": "pnpm build && electron .",
    "smoke": "pnpm build && RINKA_SMOKE=1 electron ."
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "43.7.7",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "mp4box": "2.4.1",
    "preact": "11.0.1"
  }
}
